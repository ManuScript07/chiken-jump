	"А":"01110/10001/10001/11111/10001/10001/10001", "Б":"11111/10000/10000/11110/10001/10001/11110",
	"В":"11110/10001/10001/11110/10001/10001/11110", "Г":"11111/10000/10000/10000/10000/10000/10000",
	"Д":"00110/01010/01010/01010/11111/10001/10001", "Е":"11111/10000/10000/11110/10000/10000/11111",
	"Ж":"10101/10101/01110/00100/01110/10101/10101", "З":"11110/00001/00001/01110/00001/00001/11110",
	"И":"10001/10011/10101/10101/11001/10001/10001", "Й":"01010/00100/10011/10101/11001/10001/10001",
	"К":"10001/10010/10100/11000/10100/10010/10001", "Л":"00111/01001/01001/01001/01001/01001/10001",
	"М":"10001/11011/10101/10101/10001/10001/10001", "Н":"10001/10001/10001/11111/10001/10001/10001",
	"О":"01110/10001/10001/10001/10001/10001/01110", "П":"11111/10001/10001/10001/10001/10001/10001",
	"Р":"11110/10001/10001/11110/10000/10000/10000", "С":"01111/10000/10000/10000/10000/10000/01111",
	"Т":"11111/00100/00100/00100/00100/00100/00100", "У":"10001/10001/01010/00100/00100/01000/10000",
	"Ф":"00100/01110/10101/10101/01110/00100/00100", "Х":"10001/10001/01010/00100/01010/10001/10001",
	"Ц":"10001/10001/10001/10001/10001/11111/00001", "Ч":"10001/10001/10001/01111/00001/00001/00001",
	"Ш":"10101/10101/10101/10101/10101/10101/11111", "Щ":"10101/10101/10101/10101/10101/11111/00001",
	"Ъ":"11000/01000/01110/01001/01001/01001/01110", "Ы":"10001/10001/10001/11101/10011/10011/11101",
	"Ь":"10000/10000/11110/10001/10001/10001/11110", "Э":"11110/00001/00001/01111/00001/00001/11110",
	"Ю":"10010/10101/10101/11101/10101/10101/10010", "Я":"01111/10001/10001/01111/00101/01001/10001",
	"0":"01110/10001/10011/10101/11001/10001/01110", "1":"00100/01100/00100/00100/00100/00100/01110",
	"2":"01110/10001/00001/00010/00100/01000/11111", "3":"11110/00001/00001/01110/00001/00001/11110",
	"4":"00010/00110/01010/10010/11111/00010/00010", "5":"11111/10000/10000/11110/00001/00001/11110",
	"6":"01110/10000/10000/11110/10001/10001/01110", "7":"11111/00001/00010/00100/01000/01000/01000",
	"8":"01110/10001/10001/01110/10001/10001/01110", "9":"01110/10001/10001/01111/00001/00001/01110",
	"/":"00001/00010/00010/00100/01000/01000/10000", ":":"00000/00100/00100/00000/00100/00100/00000",
	"-":"00000/00000/00000/11111/00000/00000/00000", "!":"00100/00100/00100/00100/00100/00000/00100",
	"A":"01110/10001/10001/11111/10001/10001/10001", "D":"11110/10001/10001/10001/10001/10001/11110",
	"R":"11110/10001/10001/11110/10100/10010/10001"
}
const INK := Color("24252a")
const CREAM := Color("f1ece4")
const GREEN := Color("70ae83")
const DARK_GREEN := Color("568f6d")
const RED := Color("c85040")
const GOLD := Color("eeb749")
const SHADOW := Color("40364f")

static func text(canvas: CanvasItem, origin: Vector2, content: String, pixel: int, color: Color) -> void:
	var x := origin.x
	for character in content.to_upper():
		var glyph: String = GLYPHS.get(character, "")
		if not glyph.is_empty():
			var rows := glyph.split("/")
			for y in rows.size():
				for col in rows[y].length():
					if rows[y][col] == "1":
						canvas.draw_rect(Rect2(x + col * pixel, origin.y + y * pixel, pixel, pixel), color)
		x += pixel * 6

static func sprite(canvas: CanvasItem, origin: Vector2, rows: Array[String], palette: Dictionary, pixel: int) -> void:
	for y in rows.size():
		for x in rows[y].length():
			var key := rows[y][x]
			if palette.has(key):
				canvas.draw_rect(Rect2(origin + Vector2(x, y) * pixel, Vector2.ONE * pixel), palette[key])

static func border(canvas: CanvasItem, rect: Rect2, outer: Color, inner: Color, thickness: float = 4.0) -> void:
	canvas.draw_rect(rect, outer)
	canvas.draw_rect(rect.grow(-thickness), inner)
